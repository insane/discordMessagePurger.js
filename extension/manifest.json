{
  "manifest_version": 3,
  "name": "Purge Bot",
  "version": "5.0.0",
  "description": "Bulk-delete your own Discord messages from inside your real client. No token files, no selfbot logouts.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*", "https://*.discord.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
